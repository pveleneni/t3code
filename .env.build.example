# T3 Code — build-time configuration (baked into a release)
#
# Copy this file to the repository root as `.env` (`.env.local` also works) when building by
# hand; `scripts/lib/public-config.ts` reads both, and the process environment wins over them.
# In CI, `.github/workflows/selfhost-release.yml` sets the same names from repository
# Variables, so nothing has to be committed.
#
# These values are compiled into the artifacts by CI. An end user cannot change them by
# editing `.env` at runtime unless the same name is also listed in .env.example, and a
# rebuild is the only way to change a value that is not runtime-overridable.
#
# Where they go in GitHub: Settings → Secrets and variables → Actions → **Variables**.
# They are public identifiers, not secrets — a Variable is visible, inheritable and
# reviewable, while a Secret that is merely wrong fails silently forever. The only real
# secrets a build needs are code-signing credentials (below), and those are optional: with
# none set, the release is still produced, just unsigned.
#
# Bundled into the web client, the Electron main process and the server bundle:

# Your Clerk instance, so the shipped build has working sign-in with zero user config.
# Leaving these empty ships a build whose cloud features stay off until a user sets them in
# `$T3CODE_HOME/.env`.
T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
T3CODE_CLERK_PASSKEY_RELYING_PARTY=
T3CODE_CLERK_PASSKEY_RP_DOMAINS=

# Your hosted origin and relay origin.
T3CODE_HOSTED_APP_URL=
T3CODE_RELAY_URL=

# Web client only (Vite inlines these at build time).
VITE_HOSTED_APP_URL=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_JWT_TEMPLATE=
VITE_CLERK_CLI_OAUTH_CLIENT_ID=
VITE_T3CODE_RELAY_URL=
T3CODE_WEB_ROUTER_HOST=
T3CODE_WEB_LATEST_ORIGIN=
T3CODE_WEB_NIGHTLY_ORIGIN=

# Mobile app only. These cannot be changed after the fact: a user who wants their own domain
# and their own Clerk on mobile has to build the app, unlike the desktop and CLI artifacts.
EXPO_PUBLIC_HOSTED_APP_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PASSKEY_RELYING_PARTY=
EXPO_PUBLIC_MARKETING_SITE_URL=

# Where the shipped build points for installs, downloads, docs and issues. These make
# `t3 update`, the install commands shown in the UI and the docs links resolve to your repo
# instead of upstream.
T3CODE_GITHUB_REPOSITORY=
T3CODE_RELEASE_REPOSITORY=
T3CODE_RELEASE_BASE_URL=
T3CODE_DESKTOP_UPDATE_REPOSITORY=
T3CODE_INSTALL_URL=
T3CODE_INSTALL_PS1_URL=
T3CODE_DOWNLOAD_URL=
T3CODE_DOCS_BASE_URL=
T3CODE_ISSUE_URL=
T3CODE_MODEL_MANIFEST_URL=

# Telemetry channel stamped into the build ("dev" for a fork that is not the upstream repo).
T3CODE_TELEMETRY_CHANNEL=dev

# --- Optional code signing (the only real build secrets) ---------------------
# macOS: a Developer ID certificate plus notarization credentials. Without them the .dmg is
# unsigned and Gatekeeper asks the user to right-click → Open.
#   CSC_LINK                      base64 of the .p12
#   CSC_KEY_PASSWORD              its password
#   APPLE_API_KEY / _ID / _ISSUER App Store Connect API key for notarization
# Windows: an Azure Trusted Signing account, or a .pfx in CSC_LINK. Unsigned .exe installers
#   raise SmartScreen warnings until enough users accept them.
#   AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET
#   AZURE_TRUSTED_SIGNING_ENDPOINT / _ACCOUNT_NAME / _CERTIFICATE_PROFILE_NAME
