# Self-hosted build configuration
# Copy to `.env` and fill in only the services you run. Nothing here is required
# for a local-only server: unset values disable the related cloud feature.
# These are public identifiers/config, not server-side secrets, unless noted.

# --- Your Clerk instance (auth) -------------------------------------------------
# Get these from your Clerk Dashboard under API keys, JWT templates, and OAuth
# applications. There is no built-in T3 Clerk instance.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# T3CODE_CLERK_JWT_TEMPLATE=your-jwt-template
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=your-oauth-client-id
# T3CODE_CLERK_PASSKEY_RELYING_PARTY=clerk.example.com
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional: signed macOS passkey builds.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile

# --- Hosted web app / links -----------------------------------------------------
# Your own web app origin. Used for hosted links, CLI auth, and mobile deep links.
# T3CODE_HOSTED_APP_URL=https://app.example.com
# VITE_HOSTED_APP_URL=https://app.example.com
# EXPO_PUBLIC_HOSTED_APP_URL=https://app.example.com
# EXPO_PUBLIC_CLERK_PASSKEY_RELYING_PARTY=clerk.example.com
# EXPO_PUBLIC_MARKETING_SITE_URL=https://example.com
# T3CODE_WEB_ROUTER_HOST=app.example.com
# T3CODE_WEB_LATEST_ORIGIN=https://latest.app.example.com
# T3CODE_WEB_NIGHTLY_ORIGIN=https://nightly.app.example.com

# --- Self-hosted relay (optional) ----------------------------------------------
# `infra/relay` deploys one on your own Cloudflare account.
# T3CODE_RELAY_URL=https://relay.example.com

# --- Direct Cloudflare Tunnel (optional, bypasses relay-managed tunnels) --------
# Requires a Cloudflare API token with Account:Cloudflare Tunnel:Edit and
# Zone:DNS:Edit, plus the zone that owns the hostname. The tunnel and DNS record
# are reused across restarts and are not deleted on shutdown.
# T3CODE_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# T3CODE_CLOUDFLARE_ACCOUNT_ID=your_account_id
# T3CODE_CLOUDFLARE_ZONE_ID=your_zone_id
# T3CODE_CLOUDFLARE_TUNNEL_HOSTNAME=t3.example.com
# T3CODE_CLOUDFLARE_TUNNEL_NAME=t3code-fork

# --- Product analytics (off by default) -----------------------------------------
# Set all three to send events to your own PostHog project. No default key or host
# exists. Events contain no install ID, account ID, hostname, OS, or device model.
# T3CODE_TELEMETRY_ENABLED=true
# T3CODE_POSTHOG_KEY=phc_your_project_key
# T3CODE_POSTHOG_HOST=https://posthog.example.com
# T3CODE_POSTHOG_DISTINCT_ID=t3code-fork

# --- Fork distribution URLs -----------------------------------------------------
# Unset links and commands are hidden/fail with a named-env message. Use your fork
# repository and release assets, or your own mirrors.
# T3CODE_GITHUB_REPOSITORY=pveleneni/t3code
# T3CODE_RELEASE_REPOSITORY=pveleneni/t3code
# T3CODE_RELEASE_BASE_URL=https://github.com/pveleneni/t3code/releases/download
# T3CODE_DESKTOP_UPDATE_REPOSITORY=pveleneni/t3code
# T3CODE_DOCS_BASE_URL=https://github.com/pveleneni/t3code/blob/main/docs
# T3CODE_INSTALL_URL=https://raw.githubusercontent.com/pveleneni/t3code/main/scripts/install.sh
# T3CODE_INSTALL_PS1_URL=https://raw.githubusercontent.com/pveleneni/t3code/main/scripts/install.ps1
# T3CODE_DOWNLOAD_URL=https://github.com/pveleneni/t3code/releases
# T3CODE_PRIVACY_URL=https://example.com/privacy
# T3CODE_ISSUE_URL=https://github.com/pveleneni/t3code/issues/new
# T3CODE_MODEL_MANIFEST_URL=https://raw.githubusercontent.com/pveleneni/t3code/main/apps/server/src/provider/model-manifest.json
