# T3 Code — runtime configuration for a self-hosted install
#
# This is the file an end user edits. It is NOT the build template: values baked into a
# release by CI live in .env.build.example, which is the one to copy to a repo-root `.env`.
#
# Copy this file to one of these places, then restart the server (`t3 service restart`, or
# stop and start `t3`). No rebuild, no fork, no re-download:
#
#   $T3CODE_HOME/.env     default ~/.t3/.env — belongs to this install, every key works
#   $HOME/.env                              — shared with other tools, only T3CODE_* is read
#
# Precedence, lowest to highest:
#   $HOME/.env  <  $T3CODE_HOME/.env  <  service.env  <  the real process environment
#
# service.env is written by `t3 up` and owns the network keys (host, port, LAN, T3 Connect);
# change it through the CLI rather than by hand.
#
# Nothing here is required for a local-only server: an unset value disables the related cloud
# feature instead of failing. `# public` = safe to share or commit, `# secret` = never commit.
#
# Values baked into a release at build time are listed in .env.build.example. Anything set
# here wins over a build default, so set only what you want to change.

# --- Authentication: your own Clerk instance -------------------------------- # public
# Create an application at https://dashboard.clerk.com. There is no shared T3 instance:
# without these, hosted links and cloud sign-in stay off and local use is unaffected.
# The publishable key is public by design; the server derives the Clerk frontend API URL
# from it, so a typo shows up as "no cloud UI" rather than as an error.
# T3CODE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# T3CODE_CLERK_JWT_TEMPLATE=your-jwt-template
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=your-oauth-client-id
# T3CODE_CLERK_PASSKEY_RELYING_PARTY=clerk.example.com
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com
# Required to enable Clerk sign-in from your own mobile build: comma-separated Clerk user IDs
# allowed to sign in (find them in the Clerk dashboard under Users). Unset means disabled.
# Also set sign-up mode to Restricted in Clerk so strangers cannot create accounts.
# T3CODE_CLERK_ALLOWED_USER_IDS=user_abc123,user_def456

# --- Hosted web app and links ----------------------------------------------- # public
# The origin users reach this install at. Also used for CLI login and mobile deep links.
# Must be https for anything other than localhost.
# T3CODE_HOSTED_APP_URL=https://app.example.com

# --- Self-hosted relay (optional) ------------------------------------------- # public
# Only needed if you deployed `infra/relay` on your own Cloudflare account.
# T3CODE_RELAY_URL=https://relay.example.com

# --- Direct Cloudflare Tunnel (optional) ------------------------------------ # public + secret
# Lets this install be reached from outside without opening a port. `t3` provisions the
# tunnel and the DNS record on first use and reuses them across restarts.
#
# The API token is the one real secret in this file. Scope it to a single zone:
#   Account → Cloudflare Tunnel → Edit
#   Zone    → DNS                 → Edit
# An account-wide token turns this config file into an account takeover. On Windows this
# file is protected by your profile's NTFS inheritance, not by file modes, so keep it inside
# `%USERPROFILE%` and never on a share.
# T3CODE_CLOUDFLARE_API_TOKEN=                       # secret
# T3CODE_CLOUDFLARE_ACCOUNT_ID=
# T3CODE_CLOUDFLARE_ZONE_ID=
# T3CODE_CLOUDFLARE_TUNNEL_HOSTNAME=t3.example.com
# T3CODE_CLOUDFLARE_TUNNEL_NAME=t3code

# --- Product analytics (off by default) ------------------------------------- # public
# Sends events to your own PostHog project. Nothing is sent unless all of these are set.
# Events carry no install ID, account ID, hostname, OS or device model.
# T3CODE_TELEMETRY_ENABLED=true
# T3CODE_POSTHOG_KEY=phc_your_project_key
# T3CODE_POSTHOG_HOST=https://posthog.example.com
# T3CODE_POSTHOG_DISTINCT_ID=t3code

# --- Distribution links (already baked by the release you downloaded) -------- # public
# Override these only when you publish your own builds or mirror the release assets. Left
# unset, the links and install commands point at the release you installed.
# T3CODE_GITHUB_REPOSITORY=your-org/your-repo
# T3CODE_RELEASE_REPOSITORY=your-org/your-repo
# T3CODE_RELEASE_BASE_URL=https://github.com/your-org/your-repo/releases/download
# T3CODE_DESKTOP_UPDATE_REPOSITORY=your-org/your-repo
# T3CODE_INSTALL_URL=https://raw.githubusercontent.com/your-org/your-repo/main/scripts/install.sh
# T3CODE_INSTALL_PS1_URL=https://raw.githubusercontent.com/your-org/your-repo/main/scripts/install.ps1
# T3CODE_DOWNLOAD_URL=https://github.com/your-org/your-repo/releases
# T3CODE_DOCS_BASE_URL=https://github.com/your-org/your-repo/blob/main/docs
# T3CODE_ISSUE_URL=https://github.com/your-org/your-repo/issues/new
# T3CODE_PRIVACY_URL=https://example.com/privacy
# T3CODE_MODEL_MANIFEST_URL=https://raw.githubusercontent.com/your-org/your-repo/main/apps/server/src/provider/model-manifest.json

# --- Observability (optional) ----------------------------------------------- # secret
# OTLP trace export. The token is a write credential for your collector.
# T3CODE_OTLP_TRACES_URL=https://otlp.example.com/v1/traces
# T3CODE_OTLP_HEADERS=authorization=Bearer%20your-token
# T3CODE_OTEL_SDK_DISABLED=true
